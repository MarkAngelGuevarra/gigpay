VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Use TESTNET (default) or LOCAL/STANDALONE for stellar/quickstart; MAINNET/PUBLIC are ignored.
VITE_STELLAR_NETWORK=TESTNET
# VITE_STELLAR_NETWORK_PASSPHRASE= # Leave unset unless overriding Testnet/Standalone passphrase
VITE_OFFLINE_DEMO=false # Set to true for completely offline local development
VITE_ENABLE_PILOT_TOOLS=false # Set to true to enable pilot banners, guide overlay, and feedback prompts
# Optional network overrides (leave commented so VITE_STELLAR_NETWORK=LOCAL activates Quickstart defaults):
# VITE_SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
# VITE_HORIZON_URL=http://localhost:8000
# VITE_FRIENDBOT_URL=http://localhost:8000/friendbot
# VITE_GIGPAY_ESCROW_CONTRACT_ID=CAUU2O5Z3XPYEXPS4RNHSEEROBCF3BNUFLFL5XRCPAISV3B56SOB7RD3
# VITE_EXPLORER_BASE_URL= # Set empty "" to disable explorer links even on Testnet
# VITE_GOOGLE_SHEETS_WEBHOOK_URL= # Optional Apps Script webhook URL for pilot logging
# Edge Function (`fund-practice-wallet`) Docker env (use host.docker.internal to reach host Quickstart):
# STELLAR_NETWORK=LOCAL
# STELLAR_HORIZON_URL=http://host.docker.internal:8000
# STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
