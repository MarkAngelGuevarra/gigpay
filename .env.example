VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_STELLAR_NETWORK=TESTNET # Testnet only; the app ignores other values
VITE_OFFLINE_DEMO=false # Set to true for completely offline local development
VITE_ENABLE_PILOT_TOOLS=false # Set to true to enable pilot banners, guide overlay, and feedback prompts
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_GOOGLE_SHEETS_WEBHOOK_URL= # Optional Apps Script webhook URL for pilot logging
